# ===========================================
# Lateral Flow Scanner Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# ===========================================

# ===========================================
# Application Settings
# ===========================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=lateralflowscanner://

# ===========================================
# MongoDB Atlas [REQUIRED]
# ===========================================
# Get these from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lateral_flow_scanner?retryWrites=true&w=majority
# ===========================================
# PostgreSQL / Supabase (for audit logs)
# ===========================================
# Get these from: https://supabase.com - Project Settings > Database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
POSTGRES_URI=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ===========================================
# Redis / Upstash [REQUIRED]
# ===========================================
# Local Redis for development:
REDIS_URL=redis://localhost:6379

# Upstash Redis (production) - Get from: https://upstash.com
# Format: rediss://<password>@<endpoint>:<port>
UPSTASH_REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# ===========================================
# Cloudflare R2 Storage [REQUIRED]
# ===========================================
# Get these from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lateral-flow-captures
# Public URL for accessing stored images
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# ===========================================
# Kafka (async processing)
# ===========================================
# Local Kafka for development:
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=lateral-flow-backend

# For Confluent Cloud or other providers:
# KAFKA_BROKERS=pkc-xxxxx.region.provider.confluent.cloud:9092
# KAFKA_SASL_USERNAME=your_api_key
# KAFKA_SASL_PASSWORD=your_api_secret

KAFKAJS_NO_PARTITIONER_WARNING=1

# ===========================================
# BullMQ Configuration (uses Redis)
# ===========================================
# BullMQ uses the REDIS_URL or UPSTASH_REDIS_URL above
# Queue-specific settings:
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRIES=3

# ===========================================
# JWT Authentication [REQUIRED]
# ===========================================
# Generate secure secrets: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# Google OAuth Configuration
# ===========================================
# Get from: https://console.developers.google.com
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ===========================================
# Facebook OAuth Configuration
# ===========================================
# Get from: https://developers.facebook.com
# 1. Create a new app
# 2. Add Facebook Login product
# 3. Configure OAuth settings
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# ===========================================
# OTP Configuration
# ===========================================
# OTP expiry time in minutes
OTP_EXPIRY_MINUTES=10
# OTP length (number of digits)
OTP_LENGTH=6
# Maximum OTP resend attempts per hour
OTP_MAX_RESEND_ATTEMPTS=5
# Cooldown between OTP resends in seconds
OTP_RESEND_COOLDOWN_SECONDS=60

# ===========================================
# Password Reset Configuration
# ===========================================
# Password reset token expiry in hours
PASSWORD_RESET_EXPIRY_HOURS=1
# Maximum password reset attempts per day
PASSWORD_RESET_MAX_ATTEMPTS=5

# ===========================================
# Account Security Configuration
# ===========================================
# Maximum failed login attempts before account lock
MAX_LOGIN_ATTEMPTS=5
# Account lock duration in minutes
ACCOUNT_LOCK_DURATION_MINUTES=15
# Session timeout in hours (for inactive sessions)
SESSION_TIMEOUT_HOURS=24
# Maximum concurrent sessions per user (0 = unlimited)
MAX_SESSIONS_PER_USER=5

# ===========================================
# Password Validation Rules
# ===========================================
# Minimum password length
PASSWORD_MIN_LENGTH=8
# Maximum password length
PASSWORD_MAX_LENGTH=128
# Require uppercase letter
PASSWORD_REQUIRE_UPPERCASE=true
# Require lowercase letter
PASSWORD_REQUIRE_LOWERCASE=true
# Require number
PASSWORD_REQUIRE_NUMBER=true
# Require special character
PASSWORD_REQUIRE_SPECIAL=true

# ===========================================
# Email / SMTP Configuration
# ===========================================
# For services like SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@lateralflowscanner.com
SMTP_FROM_NAME=Lateral Flow Scanner

# Email rate limiting
EMAIL_MAX_SEND_PER_HOUR=100
EMAIL_MAX_SEND_PER_DAY=500

# ===========================================
# CORS Configuration
# ===========================================
# Use * for development, specific origins for production
CORS_ORIGIN=*
# For production: CORS_ORIGIN=https://yourapp.com,https://admin.yourapp.com

# ===========================================
# Sentry Error Monitoring
# ===========================================
# Get from: https://sentry.io - Project Settings > Client Keys (DSN)
SENTRY_DSN=https://xxxxx@oxxxxx.ingest.sentry.io/xxxxx

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limits
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug, silly

# ===========================================
# File Upload Limits
# ===========================================
MAX_FILE_SIZE=52428800
# 50MB in bytes (50 * 1024 * 1024)

# ===========================================
# Webhook Configuration (Optional)
# ===========================================
WEBHOOK_SECRET=your_webhook_signing_secret
WEBHOOK_CALLBACK_URL=https://yourapp.com/api/webhooks/callback

# ===========================================
# Two-Factor Authentication (Optional)
# ===========================================
# Enable 2FA for admin users
ENABLE_2FA=false
# 2FA issuer name (shown in authenticator apps)
TWO_FA_ISSUER=LateralFlowScanner

# ===========================================
# Firebase Configuration (for Notifications) [REQUIRED]
# ===========================================
# Path to service account file (recommended for dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# OR Raw JSON content (recommended for production/containers)
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "...", ...}

# ===========================================
# Access Control (Internal Security) [REQUIRED]
# ===========================================
# Code required for user registration
INVITE_CODE=LATERAL_2024
# Code required for admin registration
ADMIN_INVITE_CODE=ADMIN_LATERAL_2024