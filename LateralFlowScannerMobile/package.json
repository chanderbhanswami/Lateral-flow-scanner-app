{
  "name": "lateralflowscannermobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "clean": "cd android && ./gradlew clean && cd ../ios && pod deintegrate && pod install && cd ..",
    "clean:android": "cd android && ./gradlew clean",
    "clean:ios": "cd ios && pod deintegrate && pod install",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace LateralFlowScanner.xcworkspace -scheme LateralFlowScanner -configuration Release archive",
    "postinstall": "cd ios && pod install && cd ..",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios/main.jsbundle"
  },
  "dependencies": {
    "@lateralflowscanner/shared": "../Shared",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/messaging": "^23.7.0",
    "@react-native-google-signin/google-signin": "^11.0.0",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/stack": "^7.6.13",
    "@sentry/react-native": "^7.8.0",
    "@shopify/react-native-skia": "^2.4.14",
    "@tanstack/react-query": "^5.90.16",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-blob-util": "^0.24.6",
    "react-native-config": "^1.6.1",
    "react-native-crypto": "^2.2.1",
    "react-native-device-info": "^15.0.1",
    "react-native-exif": "^0.5.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-fast-opencv": "^0.4.7",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-image-resizer": "^1.4.5",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^2.12.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-nitro-modules": "^0.32.0",
    "react-native-permissions": "^5.4.4",
    "react-native-proximity": "^3.0.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.19.0",
    "react-native-sensors": "^7.3.6",
    "react-native-svg": "^15.15.1",
    "react-native-svg-transformer": "^1.5.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-torch": "^1.2.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets-core": "^1.6.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native": "^0.73.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11",
    "yarn": ">=1.22"
  }
}
